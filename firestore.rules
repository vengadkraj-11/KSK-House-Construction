rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function memberRole(projectId) {
      let memberPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(memberPath)
        && get(memberPath).data.get('projectId', null) == projectId
        ? get(memberPath).data.get('role', null)
        : null;
    }
    function viewerAccessPath(uid) {
      return /databases/$(database)/documents/viewerAccess/$(uid);
    }
    function viewerPhoneIndexPath(phone) {
      return /databases/$(database)/documents/viewerPhoneIndex/$(phone);
    }
    function viewerPhoneStatusPath(phone) {
      return /databases/$(database)/documents/viewerPhoneStatus/$(phone);
    }
    function viewerRecoveryPath(uid) {
      return /databases/$(database)/documents/viewerRecoveryRequests/$(uid);
    }
    function viewerAccountDeletionPath(uid) {
      return /databases/$(database)/documents/viewerAccountDeletions/$(uid);
    }
    function validViewerAccountDeletion(uid) {
      let accessPath = viewerAccessPath(uid);
      let memberPath = /databases/$(database)/documents/users/$(uid);
      return isOwner('ksk')
        && uid != request.auth.uid
        && ((exists(accessPath)
            && get(accessPath).data.get('uid', null) == uid
            && get(accessPath).data.get('status', null) in ['pending', 'approved', 'rejected', 'revoked'])
          || (exists(memberPath)
            && get(memberPath).data.get('projectId', null) == 'ksk'
            && get(memberPath).data.get('role', null) == 'viewer'));
    }
    function hasVerifiedPhone() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'phone'
        && request.auth.token.get('phone_number', '') is string;
    }
    function hasFamilyAuth() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider in ['anonymous', 'password'];
    }
    function hasApprovedViewerAccess(projectId) {
      let accessPath = viewerAccessPath(request.auth.uid);
      return signedIn()
        && projectId == 'ksk'
        && exists(accessPath)
        && get(accessPath).data.get('status', null) == 'approved'
        && get(accessPath).data.get('approvalDate', null) is timestamp;
    }
    function hasLegacyProjectAccess(projectId) {
      let accessPath = viewerAccessPath(request.auth.uid);
      return signedIn()
        && !exists(accessPath)
        && memberRole(projectId) == 'viewer';
    }
    function hasProjectAccess(projectId) {
      return signedIn() && (
        memberRole(projectId) == 'owner'
        || hasApprovedViewerAccess(projectId)
        || hasLegacyProjectAccess(projectId)
      );
    }
    function isOwner(projectId) {
      return signedIn() && memberRole(projectId) == 'owner';
    }
    function isViewerSheet(sheetId) {
      return sheetId in [
          'project_dashboard', 'project_setup', 'materials_ground',
          'materials_first', 'materials_boq', 'labour_work',
          'professional_fees', 'misc_equipment', 'daily_expenses',
          'work_schedule', 'floor_summary'
        ];
    }
    function canReadViewerSheet(projectId, sheetId) {
      return isOwner(projectId)
        || (isViewerSheet(sheetId)
          && (hasApprovedViewerAccess(projectId) || hasLegacyProjectAccess(projectId)));
    }
    function validViewerRequestCreate(uid) {
      let data = request.resource.data;
      let phone = data.get('normalizedMobileNumber', '');
      let indexPath = viewerPhoneIndexPath(phone);
      return hasFamilyAuth()
        && uid == request.auth.uid
        && data.keys().hasAll(['uid', 'fullName', 'normalizedMobileNumber', 'status', 'preferredLanguage', 'registeredAt', 'createdAt'])
        && data.keys().hasOnly(['uid', 'fullName', 'normalizedMobileNumber', 'status', 'preferredLanguage', 'registeredAt', 'createdAt'])
        && data.uid == uid
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 120
        && phone.matches('^\\+[1-9][0-9]{7,14}$')
        && data.status == 'pending'
        && data.preferredLanguage in ['en', 'ta']
        && data.registeredAt == request.time
        && data.createdAt == request.time
        && !exists(viewerAccountDeletionPath(uid))
        && !exists(indexPath)
        && existsAfter(indexPath)
        && getAfter(indexPath).data.get('uid', null) == uid
        && getAfter(indexPath).data.get('status', null) == 'pending'
        && existsAfter(viewerPhoneStatusPath(phone))
        && getAfter(viewerPhoneStatusPath(phone)).data.get('status', null) == 'pending';
    }
    function validViewerHistoryCreate(uid) {
      let data = request.resource.data;
      let phone = data.get('normalizedMobileNumber', '');
      let requestPath = viewerAccessPath(uid);
      let recoveryRequestPath = viewerRecoveryPath(uid);
      let registration = data.get('action', null) == 'registered'
        && data.get('status', null) == 'pending'
        && existsAfter(requestPath)
        && getAfter(requestPath).data.get('fullName', null) == data.get('fullName', null)
        && getAfter(requestPath).data.get('normalizedMobileNumber', null) == phone
        && getAfter(requestPath).data.get('status', null) == 'pending';
      let recovery = data.get('action', null) == 'recovery_requested'
        && data.get('status', null) == 'pending'
        && existsAfter(recoveryRequestPath)
        && getAfter(recoveryRequestPath).data.get('normalizedMobileNumber', null) == phone
        && getAfter(recoveryRequestPath).data.get('status', null) == 'pending';
      return hasFamilyAuth()
        && uid == request.auth.uid
        && data.keys().hasAll(['uid', 'fullName', 'normalizedMobileNumber', 'action', 'status', 'actorUid', 'createdAt'])
        && data.keys().hasOnly(['uid', 'fullName', 'normalizedMobileNumber', 'action', 'status', 'actorUid', 'createdAt'])
        && data.get('uid', null) == uid
        && data.get('actorUid', null) == uid
        && data.get('fullName', null) is string
        && phone.matches('^\\+[1-9][0-9]{7,14}$')
        && data.get('createdAt', null) == request.time
        && (registration || recovery);
    }
    function validOwnerViewerHistoryCreate() {
      let data = request.resource.data;
      return isOwner('ksk')
        && data.keys().hasAll(['uid', 'fullName', 'normalizedMobileNumber', 'action', 'status', 'actorUid', 'createdAt'])
        && data.keys().hasOnly([
          'uid', 'fullName', 'normalizedMobileNumber', 'action', 'status',
          'previousStatus', 'actorUid', 'createdAt'
        ])
        && data.get('uid', null) is string
        && data.get('fullName', null) is string
        && data.get('normalizedMobileNumber', null) is string
        && data.get('action', null) in [
          'approved', 'rejected', 'revoked', 'recovery_rejected',
          'recovery_restored', 'history_cleared', 'account_deleted'
        ]
        && data.get('status', null) is string
        && data.get('actorUid', null) == request.auth.uid
        && data.get('createdAt', null) == request.time
        && (!data.keys().hasAny(['previousStatus']) || data.get('previousStatus', null) is string);
    }
    function validViewerDecision(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let approving = before.get('status', null) in ['pending', 'revoked']
        && after.get('status', null) == 'approved'
        && after.get('approvalDate', null) == request.time
        && after.get('approverUid', null) == request.auth.uid;
      let rejecting = before.get('status', null) == 'pending'
        && after.get('status', null) == 'rejected';
      let revoking = before.get('status', null) == 'approved'
        && after.get('status', null) == 'revoked'
        && after.get('revokedAt', null) == request.time
        && after.get('revokedBy', null) == request.auth.uid;
      return isOwner('ksk')
        && before.get('uid', null) == uid
        && after.get('uid', null) == uid
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'approvalDate', 'approverUid', 'decisionAt',
          'decidedBy', 'decisionNote', 'revokedAt', 'revokedBy', 'updatedAt'
        ])
        && after.get('decisionAt', null) == request.time
        && after.get('decidedBy', null) == request.auth.uid
        && after.get('decisionNote', '') is string
        && after.get('decisionNote', '').size() <= 500
        && after.get('updatedAt', null) == request.time
        && existsAfter(viewerPhoneIndexPath(before.get('normalizedMobileNumber', '')))
        && getAfter(viewerPhoneIndexPath(before.get('normalizedMobileNumber', ''))).data.get('uid', null) == uid
        && getAfter(viewerPhoneIndexPath(before.get('normalizedMobileNumber', ''))).data.get('status', null) == after.get('status', null)
        && existsAfter(viewerPhoneStatusPath(before.get('normalizedMobileNumber', '')))
        && getAfter(viewerPhoneStatusPath(before.get('normalizedMobileNumber', ''))).data.get('status', null) == after.get('status', null)
        && (approving || rejecting || revoking);
    }
    function validViewerPhoneIndexCreate(phone) {
      let data = request.resource.data;
      let memberPath = viewerAccessPath(data.get('uid', ''));
      let familyCreate = hasFamilyAuth()
        && data.get('uid', null) == request.auth.uid
        && existsAfter(memberPath)
        && getAfter(memberPath).data.get('uid', null) == data.get('uid', null)
        && getAfter(memberPath).data.get('normalizedMobileNumber', null) == phone
        && getAfter(memberPath).data.get('status', null) == data.get('status', null);
      let ownerMigration = isOwner('ksk')
        && existsAfter(memberPath)
        && getAfter(memberPath).data.get('normalizedMobileNumber', null) == phone
        && getAfter(memberPath).data.get('status', null) == data.get('status', null);
      return phone.matches('^\\+[1-9][0-9]{7,14}$')
        && data.keys().hasAll(['uid', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'status', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.status in ['pending', 'approved', 'rejected', 'revoked']
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && !exists(viewerPhoneIndexPath(phone))
        && (familyCreate || ownerMigration);
    }
    function validViewerPhoneIndexUpdate(phone) {
      let before = resource.data;
      let after = request.resource.data;
      let sameMember = after.get('uid', null) == before.get('uid', null)
        && existsAfter(viewerAccessPath(before.get('uid', '')))
        && getAfter(viewerAccessPath(before.get('uid', ''))).data.get('normalizedMobileNumber', null) == phone
        && getAfter(viewerAccessPath(before.get('uid', ''))).data.get('status', null) == after.get('status', null);
      let recoveryTransfer = before.get('status', null) == 'approved'
        && after.get('status', null) == 'approved'
        && after.get('uid', null) != before.get('uid', null)
        && existsAfter(viewerRecoveryPath(after.get('uid', '')))
        && getAfter(viewerRecoveryPath(after.get('uid', ''))).data.get('status', null) == 'restored'
        && getAfter(viewerRecoveryPath(after.get('uid', ''))).data.get('normalizedMobileNumber', null) == phone
        && existsAfter(viewerAccessPath(after.get('uid', '')))
        && getAfter(viewerAccessPath(after.get('uid', ''))).data.get('status', null) == 'approved'
        && getAfter(viewerAccessPath(after.get('uid', ''))).data.get('normalizedMobileNumber', null) == phone
        && existsAfter(viewerAccessPath(before.get('uid', '')))
        && getAfter(viewerAccessPath(before.get('uid', ''))).data.get('status', null) == 'revoked'
        && existsAfter(viewerPhoneStatusPath(phone))
        && getAfter(viewerPhoneStatusPath(phone)).data.get('status', null) == 'approved';
      return isOwner('ksk')
        && phone.matches('^\\+[1-9][0-9]{7,14}$')
        && after.keys().hasAll(['uid', 'status', 'createdAt', 'updatedAt'])
        && after.keys().hasOnly(['uid', 'status', 'createdAt', 'updatedAt'])
        && after.get('createdAt', null) == before.get('createdAt', null)
        && after.get('updatedAt', null) == request.time
        && existsAfter(viewerPhoneStatusPath(phone))
        && getAfter(viewerPhoneStatusPath(phone)).data.get('status', null) == after.get('status', null)
        && (sameMember || recoveryTransfer);
    }
    function validViewerPhoneStatusCreate(phone) {
      let data = request.resource.data;
      let indexPath = viewerPhoneIndexPath(phone);
      let uid = getAfter(indexPath).data.get('uid', '');
      let memberPath = viewerAccessPath(uid);
      let ownerMigration = isOwner('ksk');
      let familyCreate = hasFamilyAuth()
        && uid == request.auth.uid
        && data.get('status', null) == 'pending';
      return phone.matches('^\\+[1-9][0-9]{7,14}$')
        && data.keys().hasAll(['status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['status', 'createdAt', 'updatedAt'])
        && data.get('status', null) in ['pending', 'approved', 'rejected', 'revoked']
        && data.get('createdAt', null) == request.time
        && data.get('updatedAt', null) == request.time
        && !exists(viewerPhoneStatusPath(phone))
        && existsAfter(indexPath)
        && getAfter(indexPath).data.get('status', null) == data.get('status', null)
        && existsAfter(memberPath)
        && getAfter(memberPath).data.get('normalizedMobileNumber', null) == phone
        && getAfter(memberPath).data.get('status', null) == data.get('status', null)
        && (ownerMigration || familyCreate);
    }
    function validViewerPhoneStatusUpdate(phone) {
      let before = resource.data;
      let after = request.resource.data;
      let indexPath = viewerPhoneIndexPath(phone);
      let uid = getAfter(indexPath).data.get('uid', '');
      let memberPath = viewerAccessPath(uid);
      return isOwner('ksk')
        && phone.matches('^\\+[1-9][0-9]{7,14}$')
        && after.keys().hasAll(['status', 'createdAt', 'updatedAt'])
        && after.keys().hasOnly(['status', 'createdAt', 'updatedAt'])
        && after.get('status', null) in ['pending', 'approved', 'rejected', 'revoked']
        && after.get('createdAt', null) == before.get('createdAt', null)
        && after.get('updatedAt', null) == request.time
        && existsAfter(indexPath)
        && getAfter(indexPath).data.get('status', null) == after.get('status', null)
        && existsAfter(memberPath)
        && getAfter(memberPath).data.get('normalizedMobileNumber', null) == phone
        && getAfter(memberPath).data.get('status', null) == after.get('status', null);
    }
    function validViewerRecoveryCreate(uid) {
      let data = request.resource.data;
      let phone = data.get('normalizedMobileNumber', '');
      let indexPath = viewerPhoneIndexPath(phone);
      return hasFamilyAuth()
        && uid == request.auth.uid
        && data.keys().hasAll(['uid', 'normalizedMobileNumber', 'status', 'createdAt'])
        && data.keys().hasOnly(['uid', 'normalizedMobileNumber', 'status', 'createdAt'])
        && data.uid == uid
        && phone.matches('^\\+[1-9][0-9]{7,14}$')
        && data.status == 'pending'
        && data.createdAt == request.time
        && !exists(viewerAccessPath(uid))
        && exists(indexPath)
        && get(indexPath).data.get('uid', null) != uid
        && get(indexPath).data.get('status', null) == 'approved'
        && exists(viewerPhoneStatusPath(phone))
        && get(viewerPhoneStatusPath(phone)).data.get('status', null) == 'approved';
    }
    function validViewerRecoveryDecision(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let phone = before.get('normalizedMobileNumber', '');
      let indexPath = viewerPhoneIndexPath(phone);
      let newAccessPath = viewerAccessPath(uid);
      let restoring = before.get('status', null) == 'pending'
        && after.get('status', null) == 'restored'
        && existsAfter(indexPath)
        && getAfter(indexPath).data.get('uid', null) == uid
        && getAfter(indexPath).data.get('status', null) == 'approved'
        && existsAfter(viewerPhoneStatusPath(phone))
        && getAfter(viewerPhoneStatusPath(phone)).data.get('status', null) == 'approved'
        && existsAfter(newAccessPath)
        && getAfter(newAccessPath).data.get('status', null) == 'approved'
        && getAfter(newAccessPath).data.get('normalizedMobileNumber', null) == phone;
      let rejecting = before.get('status', null) == 'pending'
        && after.get('status', null) == 'rejected';
      return isOwner('ksk')
        && before.get('uid', null) == uid
        && after.get('uid', null) == uid
        && after.get('normalizedMobileNumber', null) == phone
        && after.diff(before).affectedKeys().hasOnly(['status', 'decidedBy', 'decisionAt', 'updatedAt'])
        && after.get('decidedBy', null) == request.auth.uid
        && after.get('decisionAt', null) == request.time
        && after.get('updatedAt', null) == request.time
        && (restoring || rejecting);
    }
    function validRecoveryViewerCreate(uid) {
      let recoveryPath = viewerRecoveryPath(uid);
      let recovery = getAfter(recoveryPath).data;
      let phone = recovery.get('normalizedMobileNumber', '');
      let indexPath = viewerPhoneIndexPath(phone);
      let oldUid = get(indexPath).data.get('uid', '');
      let oldAccessPath = viewerAccessPath(oldUid);
      let data = request.resource.data;
      return isOwner('ksk')
        && existsAfter(recoveryPath)
        && recovery.get('uid', null) == uid
        && recovery.get('status', null) == 'restored'
        && recovery.get('decidedBy', null) == request.auth.uid
        && exists(indexPath)
        && get(indexPath).data.get('status', null) == 'approved'
        && oldUid != uid
        && existsAfter(indexPath)
        && getAfter(indexPath).data.get('uid', null) == uid
        && getAfter(indexPath).data.get('status', null) == 'approved'
        && existsAfter(oldAccessPath)
        && getAfter(oldAccessPath).data.get('status', null) == 'revoked'
        && data.keys().hasAll(['uid', 'fullName', 'normalizedMobileNumber', 'status', 'preferredLanguage', 'registeredAt', 'createdAt', 'approvalDate', 'approverUid'])
        && data.keys().hasOnly(['uid', 'fullName', 'normalizedMobileNumber', 'status', 'preferredLanguage', 'registeredAt', 'createdAt', 'approvalDate', 'approverUid'])
        && data.get('uid', null) == uid
        && data.get('fullName', null) == get(oldAccessPath).data.get('fullName', null)
        && data.get('normalizedMobileNumber', null) == phone
        && data.get('status', null) == 'approved'
        && data.get('preferredLanguage', null) == get(oldAccessPath).data.get('preferredLanguage', null)
        && data.get('approvalDate', null) == get(oldAccessPath).data.get('approvalDate', null)
        && data.get('approverUid', null) == get(oldAccessPath).data.get('approverUid', null)
        && data.get('registeredAt', null) == request.time
        && data.get('createdAt', null) == request.time;
    }
    function validRecoveryTransferRevoke(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let phone = before.get('normalizedMobileNumber', '');
      let indexPath = viewerPhoneIndexPath(phone);
      let newUid = getAfter(indexPath).data.get('uid', '');
      let recoveryPath = viewerRecoveryPath(newUid);
      let newAccessPath = viewerAccessPath(newUid);
      return isOwner('ksk')
        && before.get('status', null) == 'approved'
        && before.get('uid', null) == uid
        && after.get('status', null) == 'revoked'
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'decisionAt', 'decidedBy', 'decisionNote', 'revokedAt', 'revokedBy', 'updatedAt'
        ])
        && after.get('decisionAt', null) == request.time
        && after.get('decidedBy', null) == request.auth.uid
        && after.get('decisionNote', '') is string
        && after.get('decisionNote', '') is string
        && after.get('decisionNote', '').size() <= 500
        && after.get('revokedAt', null) == request.time
        && after.get('revokedBy', null) == request.auth.uid
        && after.get('updatedAt', null) == request.time
        && existsAfter(indexPath)
        && newUid != uid
        && getAfter(indexPath).data.get('status', null) == 'approved'
        && existsAfter(newAccessPath)
        && getAfter(newAccessPath).data.get('normalizedMobileNumber', null) == phone
        && getAfter(newAccessPath).data.get('status', null) == 'approved'
        && existsAfter(recoveryPath)
        && getAfter(recoveryPath).data.get('status', null) == 'restored'
        && getAfter(recoveryPath).data.get('normalizedMobileNumber', null) == phone;
    }
    function validLegacyRevocation(uid) {
      let memberPath = /databases/$(database)/documents/users/$(uid);
      let data = request.resource.data;
      return isOwner('ksk')
        && exists(memberPath)
        && get(memberPath).data.get('projectId', null) == 'ksk'
        && get(memberPath).data.get('role', null) == 'viewer'
        && data.keys().hasAll([
          'uid', 'fullName', 'normalizedMobileNumber', 'status', 'preferredLanguage',
          'legacy', 'revokedAt', 'revokedBy', 'decisionAt', 'decidedBy',
          'decisionNote', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'fullName', 'normalizedMobileNumber', 'status', 'preferredLanguage',
          'legacy', 'revokedAt', 'revokedBy', 'decisionAt', 'decidedBy',
          'decisionNote', 'createdAt', 'updatedAt'
        ])
        && data.uid == uid
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 120
        && data.normalizedMobileNumber == ''
        && data.status == 'revoked'
        && data.preferredLanguage in ['en', 'ta']
        && data.legacy == true
        && data.revokedAt == request.time
        && data.revokedBy == request.auth.uid
        && data.decisionAt == request.time
        && data.decidedBy == request.auth.uid
        && data.decisionNote is string
        && data.decisionNote.size() <= 500
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }
    function validPaymentAgreement(projectId) {
      return !request.resource.data.keys().hasAny(['contractId'])
        || request.resource.data.contractId == ''
        || (request.resource.data.contractId is string
          && exists(/databases/$(database)/documents/projects/$(projectId)/contracts/$(request.resource.data.contractId))
          && get(/databases/$(database)/documents/projects/$(projectId)/contracts/$(request.resource.data.contractId)).data.person == request.resource.data.person);
    }
    function validPaymentCreate(projectId) {
      return request.resource.data.keys().hasAll(['createdBy', 'createdAt', 'amount', 'date'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (request.resource.data.get('paymentTo', '') is string)
        && (request.resource.data.get('person', '') is string)
        && (request.resource.data.get('paymentTo', '') != '' || request.resource.data.get('person', '') != '')
        && validPaymentAgreement(projectId);
    }

    // Role documents are provisioned by the project administrator only.
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isOwner('ksk'));
      allow list: if isOwner('ksk')
        && resource.data.get('projectId', null) == 'ksk'
        && resource.data.get('role', null) == 'viewer';
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.get('role', null) == resource.data.get('role', null)
        && request.resource.data.get('projectId', null) == resource.data.get('projectId', null)
        && request.resource.data.get('preferredLanguage', null) in ['en', 'ta']
        && request.resource.data.get('updatedAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferredLanguage', 'updatedAt']);
      allow create: if false;
      allow delete: if isOwner('ksk')
        && resource.data.get('projectId', null) == 'ksk'
        && resource.data.get('role', null) == 'viewer'
        && existsAfter(viewerAccountDeletionPath(userId))
        && getAfter(viewerAccountDeletionPath(userId)).data.get('actorUid', null) == request.auth.uid;
      match /devices/{deviceId} {
        allow read: if isOwner('ksk')
          || (signedIn() && request.auth.uid == userId && hasProjectAccess('ksk'));
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && hasProjectAccess('ksk');
        allow delete: if isOwner('ksk')
          || (signedIn()
            && request.auth.uid == userId
            && hasProjectAccess('ksk'));
      }
    }

    match /viewerAccess/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner('ksk'));
      allow list: if isOwner('ksk');
      allow create: if validViewerRequestCreate(uid) || validLegacyRevocation(uid) || validRecoveryViewerCreate(uid);
      allow update: if (signedIn()
          && request.auth.uid == uid
          && resource.data.get('uid', null) == uid
          && request.resource.data.get('uid', null) == uid
          && request.resource.data.get('status', null) == resource.data.get('status', null)
          && request.resource.data.get('normalizedMobileNumber', null) == resource.data.get('normalizedMobileNumber', null)
          && request.resource.data.get('fullName', null) == resource.data.get('fullName', null)
          && request.resource.data.get('preferredLanguage', null) in ['en', 'ta']
          && request.resource.data.get('updatedAt', null) == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferredLanguage', 'updatedAt']))
        || validViewerDecision(uid)
        || validRecoveryTransferRevoke(uid);
      allow delete: if isOwner('ksk')
        && (resource.data.get('status', null) in ['pending', 'rejected']
          || (existsAfter(viewerAccountDeletionPath(uid))
            && getAfter(viewerAccountDeletionPath(uid)).data.get('actorUid', null) == request.auth.uid));
    }

    match /viewerPhoneIndex/{phone} {
      allow get: if isOwner('ksk') || (signedIn() && resource.data.get('uid', null) == request.auth.uid);
      allow list: if isOwner('ksk');
      allow create: if validViewerPhoneIndexCreate(phone);
      allow update: if validViewerPhoneIndexUpdate(phone);
      allow delete: if isOwner('ksk')
        && (resource.data.get('status', null) in ['pending', 'rejected']
          || (!existsAfter(viewerAccessPath(resource.data.get('uid', '')))
            && existsAfter(viewerAccountDeletionPath(resource.data.get('uid', '')))
            && getAfter(viewerAccountDeletionPath(resource.data.get('uid', ''))).data.get('actorUid', null) == request.auth.uid));
    }

    match /viewerPhoneStatus/{phone} {
      allow get: if isOwner('ksk')
        || (signedIn()
          && exists(viewerPhoneIndexPath(phone))
          && get(viewerPhoneIndexPath(phone)).data.get('uid', null) == request.auth.uid);
      allow list: if false;
      allow create: if validViewerPhoneStatusCreate(phone);
      allow update: if validViewerPhoneStatusUpdate(phone);
      allow delete: if isOwner('ksk')
        && (resource.data.get('status', null) in ['pending', 'rejected']
          || (!existsAfter(viewerPhoneIndexPath(phone))
            && exists(viewerPhoneIndexPath(phone))
            && existsAfter(viewerAccountDeletionPath(get(viewerPhoneIndexPath(phone)).data.get('uid', '')))
            && getAfter(viewerAccountDeletionPath(get(viewerPhoneIndexPath(phone)).data.get('uid', ''))).data.get('actorUid', null) == request.auth.uid));
    }

    match /viewerRecoveryRequests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner('ksk'));
      allow list: if isOwner('ksk');
      allow create: if validViewerRecoveryCreate(uid);
      allow update: if validViewerRecoveryDecision(uid);
      allow delete: if isOwner('ksk')
        && resource.data.get('status', null) in ['pending', 'rejected', 'restored'];
    }

    match /viewerAccessHistory/{eventId} {
      allow read: if isOwner('ksk');
      allow create: if validOwnerViewerHistoryCreate()
        || validViewerHistoryCreate(request.resource.data.get('uid', ''));
      allow update: if false;
      allow delete: if isOwner('ksk');
    }

    match /viewerAccountDeletions/{uid} {
      allow get, list: if isOwner('ksk');
      allow create: if validViewerAccountDeletion(uid)
        && request.resource.data.keys().hasAll(['uid', 'actorUid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'actorUid', 'createdAt'])
        && request.resource.data.get('uid', null) == uid
        && request.resource.data.get('actorUid', null) == request.auth.uid
        && request.resource.data.get('createdAt', null) == request.time
        && !exists(viewerAccountDeletionPath(uid));
      allow update, delete: if false;
    }

    match /projects/{projectId}/sheets/{sheetId} {
      allow read: if canReadViewerSheet(projectId, sheetId);
      allow create, update: if isOwner(projectId)
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // Viewers can access bill receipts only; site photos remain owner-only.
    match /projects/{projectId}/{attachmentGroup}/{recordId}/images/{imageId} {
      allow read: if (attachmentGroup == 'bills'
          && (isOwner(projectId) || hasApprovedViewerAccess(projectId) || hasLegacyProjectAccess(projectId)))
        || (attachmentGroup == 'attachments' && isOwner(projectId));
      allow create: if attachmentGroup in ['bills', 'attachments'] && isOwner(projectId)
        && request.resource.data.keys().hasAll(['recordId', 'imageBase64', 'fileName', 'mimeType', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasOnly(['recordId', 'imageBase64', 'fileName', 'mimeType', 'createdBy', 'createdAt', 'restoredCreatedAt'])
        && request.resource.data.recordId == recordId
        && request.resource.data.imageBase64 is string
        && request.resource.data.imageBase64.size() > 0
        && request.resource.data.imageBase64.size() <= 450000
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() <= 200
        && request.resource.data.mimeType == 'image/jpeg'
        && request.resource.data.createdBy == 'owner'
        && request.resource.data.createdAt == request.time
        && (!request.resource.data.keys().hasAny(['restoredCreatedAt']) || request.resource.data.restoredCreatedAt is timestamp);
      allow update: if attachmentGroup in ['bills', 'attachments'] && isOwner(projectId)
        && request.resource.data.keys().hasAll(['recordId', 'imageBase64', 'fileName', 'mimeType', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasOnly(['recordId', 'imageBase64', 'fileName', 'mimeType', 'createdBy', 'createdAt', 'restoredCreatedAt'])
        && request.resource.data.recordId == recordId
        && request.resource.data.recordId == resource.data.recordId
        && request.resource.data.imageBase64 is string
        && request.resource.data.imageBase64.size() > 0
        && request.resource.data.imageBase64.size() <= 450000
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() <= 200
        && request.resource.data.mimeType == 'image/jpeg'
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && (!request.resource.data.keys().hasAny(['restoredCreatedAt']) || request.resource.data.restoredCreatedAt is timestamp);
      allow delete: if attachmentGroup in ['bills', 'attachments'] && isOwner(projectId);
    }

    // Structured project modules: all project members may read; only the
    // project owner may create or change records. Records are kept separate
    // from the original Excel-style worksheets.
    match /projects/{projectId}/payments/{recordId} {
      allow read: if hasProjectAccess(projectId);
      allow create: if isOwner(projectId) && validPaymentCreate(projectId);
      allow update: if isOwner(projectId) && validPaymentAgreement(projectId);
      allow delete: if isOwner(projectId);
    }
    match /projects/{projectId}/contracts/{recordId} {
      allow read: if hasProjectAccess(projectId);
      allow create: if isOwner(projectId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.agreedAmount is number
        && request.resource.data.agreedAmount >= 0;
      allow update, delete: if isOwner(projectId);
    }
    match /projects/{projectId}/stock/{recordId} {
      allow read: if hasProjectAccess(projectId);
      allow create: if isOwner(projectId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0;
      allow update, delete: if isOwner(projectId);
    }
    match /projects/{projectId}/progress/{recordId} {
      allow read: if hasProjectAccess(projectId);
      allow create: if isOwner(projectId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.percent is number
        && request.resource.data.percent >= 0
        && request.resource.data.percent <= 100;
      allow update, delete: if isOwner(projectId);
    }
    match /projects/{projectId}/diary/{recordId} {
      allow read: if isOwner(projectId);
      allow create: if isOwner(projectId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isOwner(projectId);
    }
    match /projects/{projectId}/approvals/{recordId} {
      allow read: if isOwner(projectId);
      allow create: if isOwner(projectId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (request.resource.data.status == 'pending'
          || (request.resource.data.status in ['approved', 'rejected']
            && request.resource.data.backupSchemaVersion == 1
            && request.resource.data.restoredFromBackupAt is string
            && request.resource.data.history is list
            && request.resource.data.history.size() > 0
            && request.resource.data.decidedBy is string
            && request.resource.data.decidedAt is timestamp
            && request.resource.data.history[request.resource.data.history.size() - 1].status == request.resource.data.status
            && request.resource.data.history[request.resource.data.history.size() - 1].actorUid == request.resource.data.decidedBy
            && request.resource.data.history[request.resource.data.history.size() - 1].decidedAt is timestamp));
      allow update: if isOwner(projectId)
        && resource.data.status in ['pending', 'Pending', 'PENDING']
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedAt', 'decisionNote', 'updatedAt', 'history'])
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.decisionNote is string
        && request.resource.data.decisionNote.size() <= 2000
        && request.resource.data.history is list
        && request.resource.data.history.size() == resource.data.get('history', []).size() + 1
        && request.resource.data.history[request.resource.data.history.size() - 1].actorUid == request.auth.uid
        && request.resource.data.history[request.resource.data.history.size() - 1].status == request.resource.data.status
        && request.resource.data.history[request.resource.data.history.size() - 1].note == request.resource.data.decisionNote
        && request.resource.data.history[request.resource.data.history.size() - 1].decidedAt is timestamp;
      allow delete: if isOwner(projectId);
    }
    match /projects/{projectId}/reminders/{recordId} {
      allow read: if isOwner(projectId);
      allow create: if isOwner(projectId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isOwner(projectId);
    }

    // Login sessions: members can manage only their own activity; owners can
    // review, revoke, and clear project-wide session history.
    match /projects/{projectId}/login_history/{sessionId} {
      allow read: if isOwner(projectId)
        || (signedIn()
          && resource.data.get('userId', null) == request.auth.uid
          && hasProjectAccess(projectId));
      allow create: if (isOwner(projectId) || hasApprovedViewerAccess(projectId) || hasLegacyProjectAccess(projectId))
        && request.resource.data.keys().hasAll([
          'userId', 'email', 'displayName', 'role', 'installationId',
          'deviceModel', 'deviceManufacturer', 'deviceName', 'platform', 'status',
          'loginAt', 'lastActiveAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'email', 'displayName', 'role', 'installationId',
          'deviceModel', 'deviceManufacturer', 'deviceName', 'platform', 'status',
          'loginAt', 'lastActiveAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role == (isOwner(projectId) ? 'owner' : 'viewer')
        && request.resource.data.status == 'active'
        && request.resource.data.loginAt == request.time
        && request.resource.data.lastActiveAt == request.time
        && request.resource.data.installationId is string
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.deviceModel is string
        && request.resource.data.deviceManufacturer is string
        && request.resource.data.deviceName is string
        && request.resource.data.platform is string;
      allow update: if (isOwner(projectId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt', 'revokedBy'])
          && request.resource.data.get('status', null) == 'revoked'
          && request.resource.data.get('revokedAt', null) == request.time
          && request.resource.data.get('revokedBy', null) == request.auth.uid)
        || (signedIn()
          && resource.data.get('userId', null) == request.auth.uid
          && hasProjectAccess(projectId)
          && resource.data.get('status', null) == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt'])
          && request.resource.data.lastActiveAt == request.time)
        || (signedIn()
          && resource.data.get('userId', null) == request.auth.uid
          && hasProjectAccess(projectId)
          && resource.data.get('status', null) == 'active'
          && request.resource.data.get('status', null) == 'ended'
          && request.resource.data.get('endedAt', null) == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt']));
      allow delete: if isOwner(projectId);
    }

    match /projects/{projectId}/activity/{activityId} {
      allow read: if isOwner(projectId);

      // Only the project owner can create activity records.
      // The actor UID and server timestamp must match the authenticated request.
      allow create: if isOwner(projectId)
        && request.resource.data.keys().hasAll([
          'actorUid', 'changeType', 'createdAt',
          'sheetId', 'sheetName', 'title', 'body'
        ])
        && request.resource.data.keys().hasOnly([
          'actorUid', 'actorName', 'changeType', 'createdAt',
          'sheetId', 'sheetName', 'title', 'body',
          'itemName', 'details', 'recordId'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.changeType == 'edited'
        && request.resource.data.createdAt == request.time
        && request.resource.data.sheetId is string
        && request.resource.data.sheetName is string
        && request.resource.data.title is string
        && request.resource.data.body is string;

      allow update: if false;
      allow delete: if isOwner(projectId);
    }
  }
}
