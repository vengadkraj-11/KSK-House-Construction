import React, {useEffect, useState} from 'react';
import {
  ActivityIndicator, Alert, Image, Modal, ScrollView,
  Text, TouchableOpacity, View
} from 'react-native';
import {
  addDoc, collection, deleteDoc, doc, onSnapshot, serverTimestamp
} from 'firebase/firestore';
import * as ImagePicker from 'expo-image-picker';
import * as ImageManipulator from 'expo-image-manipulator';
import {db} from '../firebase';

const PROJECT_ID = 'ksk';
const MAX_BASE64_LENGTH = 450000;

type BillImage = {
  id: string;
  imageBase64: string;
  fileName?: string;
  createdAt?: any;
};

export default function BillAttachments({
  recordId, canEdit, language
}: {
  recordId: string;
  canEdit: boolean;
  language: string;
}) {
  const [items, setItems] = useState<BillImage[]>([]);
  const [loading, setLoading] = useState(true);
  const [uploading, setUploading] = useState(false);
  const [selected, setSelected] = useState<BillImage | null>(null);

  const tamil = language === 'ta';
  const t = (en: string, ta: string) => tamil ? ta : en;
  const imagesPath = collection(
    db!, 'projects', PROJECT_ID, 'bills', recordId, 'images'
  );

  useEffect(() => {
    if (!db || !recordId) {
      setLoading(false);
      return;
    }

    const stop = onSnapshot(imagesPath, snapshot => {
      const next = snapshot.docs.map(d => ({
        id: d.id,
        ...d.data()
      } as BillImage));

      next.sort((a, b) => {
        const at = a.createdAt?.toMillis?.() || 0;
        const bt = b.createdAt?.toMillis?.() || 0;
        return bt - at;
      });

      setItems(next);
      setLoading(false);
    }, error => {
      setLoading(false);
      Alert.alert(t('Bills unavailable', 'ரசீதுகளைக் காண முடியவில்லை'), error.message);
    });

    return stop;
  }, [recordId]);

  const chooseImage = async (camera: boolean) => {
    if (!canEdit || !db) return;

    try {
      let result: ImagePicker.ImagePickerResult;

      if (camera) {
        const permission = await ImagePicker.requestCameraPermissionsAsync();
        if (!permission.granted) {
          Alert.alert(
            t('Camera permission', 'கேமரா அனுமதி'),
            t('Allow camera access to take a receipt photo.', 'ரசீது புகைப்படம் எடுக்க கேமரா அனுமதி வழங்கவும்.')
          );
          return;
        }

        result = await ImagePicker.launchCameraAsync({
          mediaTypes: ['images'] as any,
          quality: 1
        });
      } else {
        const permission = await ImagePicker.requestMediaLibraryPermissionsAsync();
        if (!permission.granted) {
          Alert.alert(
            t('Gallery permission', 'கேலரி அனுமதி'),
            t('Allow photo library access to select a receipt.', 'ரசீதைத் தேர்ந்தெடுக்க புகைப்பட அனுமதி வழங்கவும்.')
          );
          return;
        }

        result = await ImagePicker.launchImageLibraryAsync({
          mediaTypes: ['images'] as any,
          quality: 1
        });
      }

      if (result.canceled || !result.assets?.length) return;

      setUploading(true);
      const uri = result.assets[0].uri;
      let base64 = '';

      // Reduce dimensions and quality until the Firestore document is safely below 1 MiB.
      for (const width of [1280, 1000, 800]) {
        for (const quality of [0.6, 0.45, 0.3]) {
          const compressed = await ImageManipulator.manipulateAsync(
            uri,
            [{resize: {width}}],
            {
              compress: quality,
              format: ImageManipulator.SaveFormat.JPEG,
              base64: true
            }
          );

          base64 = compressed.base64 || '';
          if (base64.length > 0 && base64.length <= MAX_BASE64_LENGTH) break;
        }
        if (base64.length > 0 && base64.length <= MAX_BASE64_LENGTH) break;
      }

      if (!base64 || base64.length > MAX_BASE64_LENGTH) {
        throw new Error(
          t(
            'This photo is too large to store safely. Try a smaller or clearer cropped photo.',
            'இந்தப் புகைப்படம் சேமிக்க மிகவும் பெரியது. சிறிய அல்லது வெட்டப்பட்ட புகைப்படத்தை முயற்சிக்கவும்.'
          )
        );
      }

      await addDoc(imagesPath, {
        recordId,
        imageBase64: base64,
        fileName: `receipt-${Date.now()}.jpg`,
        mimeType: 'image/jpeg',
        createdBy: 'owner',
        createdAt: serverTimestamp()
      });

      Alert.alert(
        t('Receipt attached', 'ரசீது இணைக்கப்பட்டது'),
        t('The receipt is now available to project members.', 'இந்த ரசீதை திட்ட உறுப்பினர்கள் இப்போது பார்க்கலாம்.')
      );
    } catch (error: any) {
      Alert.alert(
        t('Upload failed', 'பதிவேற்றம் தோல்வியடைந்தது'),
        error?.message || t('Please try again.', 'மீண்டும் முயற்சிக்கவும்.')
      );
    } finally {
      setUploading(false);
    }
  };

  const removeImage = (item: BillImage) => {
    if (!canEdit || !db) return;

    Alert.alert(
      t('Delete receipt?', 'ரசீதை நீக்கவா?'),
      t('This image will be permanently deleted.', 'இந்தப் படம் நிரந்தரமாக நீக்கப்படும்.'),
      [
        {text: t('Cancel', 'ரத்து'), style: 'cancel'},
        {
          text: t('Delete', 'நீக்கு'),
          style: 'destructive',
          onPress: async () => {
            try {
              await deleteDoc(doc(imagesPath, item.id));
              if (selected?.id === item.id) setSelected(null);
            } catch (error: any) {
              Alert.alert(t('Delete failed', 'நீக்க முடியவில்லை'), error?.message || '');
            }
          }
        }
      ]
    );
  };

  return (
    <View style={{marginTop: 12, paddingTop: 10, borderTopWidth: 1, borderTopColor: '#E2E9E5'}}>
      <View style={{flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between'}}>
        <Text style={{fontSize: 12, color: '#365775', fontWeight: '800'}}>
          {t('Bills / receipts', 'பில்கள் / ரசீதுகள்')} ({items.length})
        </Text>
        {canEdit ? (
          <View style={{flexDirection: 'row', gap: 8}}>
            <TouchableOpacity
              disabled={uploading}
              onPress={() => chooseImage(false)}
              style={{paddingHorizontal: 10, paddingVertical: 7, borderRadius: 8, backgroundColor: '#E6F1EC'}}>
              <Text style={{fontSize: 11, color: '#1C6255', fontWeight: '800'}}>
                {t('Gallery +', 'கேலரி +')}
              </Text>
            </TouchableOpacity>
            <TouchableOpacity
              disabled={uploading}
              onPress={() => chooseImage(true)}
              style={{paddingHorizontal: 10, paddingVertical: 7, borderRadius: 8, backgroundColor: '#EAF0F7'}}>
              <Text style={{fontSize: 11, color: '#365775', fontWeight: '800'}}>
                {t('Camera', 'கேமரா')}
              </Text>
            </TouchableOpacity>
          </View>
        ) : null}
      </View>

      {uploading ? (
        <View style={{flexDirection: 'row', alignItems: 'center', marginTop: 10}}>
          <ActivityIndicator size="small" color="#1C6255"/>
          <Text style={{marginLeft: 8, fontSize: 11, color: '#6F817C'}}>
            {t('Compressing and uploading…', 'சுருக்கி பதிவேற்றுகிறது…')}
          </Text>
        </View>
      ) : null}

      {loading ? (
        <ActivityIndicator size="small" color="#1C6255" style={{marginTop: 10}}/>
      ) : items.length === 0 ? (
        <Text style={{fontSize: 11, color: '#6F817C', marginTop: 8}}>
          {t('No bill attached yet.', 'இதுவரை ரசீது இணைக்கப்படவில்லை.')}
        </Text>
      ) : (
        <View style={{flexDirection: 'row', flexWrap: 'wrap', gap: 8, marginTop: 9}}>
          {items.map(item => (
            <View key={item.id} style={{flexDirection: 'row', alignItems: 'center', gap: 5}}>
              <TouchableOpacity
                onPress={() => setSelected(item)}
                style={{paddingHorizontal: 10, paddingVertical: 7, borderRadius: 8, backgroundColor: '#EAF0F7'}}>
                <Text style={{fontSize: 11, color: '#365775', fontWeight: '700'}}>
                  {t('View receipt', 'ரசீதைப் பார்')}
                </Text>
              </TouchableOpacity>
              {canEdit ? (
                <TouchableOpacity
                  onPress={() => removeImage(item)}
                  style={{paddingHorizontal: 8, paddingVertical: 7, borderRadius: 8, backgroundColor: '#FDECEC'}}>
                  <Text style={{fontSize: 11, color: '#B42318', fontWeight: '800'}}>
                    {t('Remove', 'நீக்கு')}
                  </Text>
                </TouchableOpacity>
              ) : null}
            </View>
          ))}
        </View>
      )}

      <Modal visible={!!selected} transparent animationType="fade" onRequestClose={() => setSelected(null)}>
        <View style={{flex: 1, backgroundColor: 'rgba(0,0,0,0.88)', justifyContent: 'center', padding: 14}}>
          <TouchableOpacity
            onPress={() => setSelected(null)}
            style={{alignSelf: 'flex-end', padding: 12}}>
            <Text style={{color: '#FFFFFF', fontWeight: '800'}}>{t('Close ✕', 'மூடு ✕')}</Text>
          </TouchableOpacity>
          {selected ? (
            <Image
              source={{uri: `data:image/jpeg;base64,${selected.imageBase64}`}}
              resizeMode="contain"
              style={{width: '100%', height: '82%'}}
            />
          ) : null}
        </View>
      </Modal>
    </View>
  );
}
