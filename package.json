{
  "name": "ksk-house-construction",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/recordMath.test.cjs tests/projectBackupValidation.test.cjs tests/websiteAccess.test.cjs tests/webFiles.test.cjs",
    "test:rules": "firebase emulators:exec --only firestore,auth --project demo-ksk \"node --test tests/firestoreRules.test.cjs tests/authFlow.test.cjs\"",
    "build:preview": "eas build --platform android --profile preview",
    "build:production": "eas build --platform android --profile production",
    "build:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.18",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-picker/picker": "2.11.4",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.0",
    "expo-device": "~57.0.0",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-notifications": "~57.0.0",
    "expo-print": "~57.0.2",
    "expo-sharing": "~57.0.24",
    "expo-status-bar": "~57.0.0",
    "firebase": "^12.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  }
}
