{
  "expo": {
    "name": "KSK House",
    "slug": "ksk-house-construction",
    "scheme": "kskhouse",
    "version": "1.0.0",
    "orientation": "portrait",
    "android": {
      "package": "com.ksk.houseconstruction",
      "versionCode": 1,
      "permissions": [
        "POST_NOTIFICATIONS",
        "INTERNET"
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#112B28",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "construction-updates"
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "e2484e3d-843a-46a9-a6a7-ce1f36783d54"
      }
    },
    "icon": "./assets/icon.png"
  }
}
